{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Minicor",
  "colors": {
    "primary": "#646ECB",
    "light": "#8A92E3",
    "dark": "#4A54B8"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Geist"
    },
    "body": {
      "family": "Geist"
    }
  },
  "background": {
    "color": {
      "light": "#f7f7f9",
      "dark": "#090a15"
    }
  },
  "appearance": {
    "default": "light"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "how-it-runs"
            ]
          },
          {
            "group": "Teaching jobs",
            "pages": [
              "teaching/samples-and-scenarios",
              "teaching/the-builder",
              "teaching/stability",
              "teaching/going-live",
              "teaching/co-pilot",
              "teaching/self-healing",
              "teaching/drilling-down"
            ]
          },
          {
            "group": "Running jobs",
            "pages": [
              "running/calling-your-job",
              "running/executions-and-replays",
              "running/desktops",
              "running/configurations"
            ]
          },
          {
            "group": "Safety and operations",
            "pages": [
              "operations/verification",
              "operations/network-boundary",
              "operations/exceptions-and-telemetry",
              "operations/monitoring-and-reporting"
            ]
          }
        ]
      },
      {
        "tab": "For agents",
        "icon": "robot",
        "groups": [
          {
            "group": "Connect an agent",
            "pages": [
              "agents/mcp",
              "agents/job-build-loop",
              "agents/sessions",
              "agents/tools"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "API reference",
            "pages": [
              "api/calling-jobs",
              "api/teach",
              "api/authentication"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "minicor.com",
        "href": "https://minicor.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://app.minicor.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://minicor.com"
    }
  }
}
